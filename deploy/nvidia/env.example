# Copy to project-root .env.nvidia; keep the filled file private.
PUBLIC_DOMAIN=voice.example.org
DUPLEX_GPU_ID=0
# Requires NVIDIA Container Toolkit on the host.
MODELS_DIR=
MODEL_INVENTORY_FILE=
ACCESS_FILE=
# Defaults are versioned public images; a registry mirror or digest can be supplied.
BASE_IMAGE=nvidia/cuda:12.8.1-cudnn-runtime-ubuntu22.04
HARNESS_ALLOWED_HOSTS=api.deepseek.com
# Set empty to disable the local organizer; persistent named volume is used by default.
PERSONAL_DB=/var/lib/duopra/personal.sqlite3
# Optional: PIP_INDEX_URL, DUPLEX_CONDA_CHANNEL, DUPLEX_TORCH_INDEX_URL,
# APT_MIRROR, MINICONDA_URL, HTTP_PROXY, HTTPS_PROXY, NO_PROXY.
